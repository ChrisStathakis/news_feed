# Build / installer output (contains .exe files; regenerated by npm run pipeline / npm run dist)
app/dist/
build/
pipeline-dist/
*.apk
*.blockmap

# Runtime data (editions, caches, health, generated images)
cache/
output/
memes/out/
memes/work/

# Local test data
.testdata/
.testdata2/

# Generated documentation site (rebuild with: mkdocs build)
site/

# Dependencies (restorable with npm install)
node_modules/

# Python bytecode (.pyc only - .pyd files are real PyInstaller binaries, keep them)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
